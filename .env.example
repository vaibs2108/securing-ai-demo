# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# Admin Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# Signs the login session token. Set a fixed random value (e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`) so sessions
# survive backend restarts. On Hugging Face Spaces / other hosts, set this
# as a platform secret (not in a committed .env) rather than here.
SESSION_SECRET=

# LangSmith (LLM Tracing & Observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-security-showcase
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional MCP Security Vendor API keys (Set to enable live data modes)
# TENABLE_API_KEY=
# QUALYS_API_KEY=
# WIZ_API_KEY=
# SNYK_API_KEY=
# JIRA_API_TOKEN=
# SERVICENOW_API_TOKEN=
