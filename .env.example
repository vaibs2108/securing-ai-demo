# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# Admin Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# Signs the login session token. Set a fixed random value (e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`) so sessions
# survive backend restarts. On Hugging Face Spaces / other hosts, set this
# as a platform secret (not in a committed .env) rather than here.
SESSION_SECRET=

# LangSmith (LLM Tracing & Observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-security-showcase
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional MCP Security Vendor API keys (real tools, app/mcp/registry.py —
# set to enable live mode; omitted falls back to a clearly-labelled mock)
# LAKERA_API_KEY=
# GARAK_RUNNER_URL=          # real self-hosted runner; see ../garak-runner (garak, real, no vendor API)
# PYRIT_RUNNER_URL=          # real self-hosted runner; see ../pyrit-runner (PyRIT, real, no vendor API)
# JIRA_URL=
# JIRA_USERNAME=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# SERVICENOW_INSTANCE=
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# ── Live demo targets (github, target_agent, slack — no mock fallback,
# see app/mcp/registry.py) ──────────────────────────────────────────────
TARGET_AGENT_URL=http://127.0.0.1:8091
TARGET_AGENT_ADMIN_TOKEN=

# Fine-grained PAT scoped to just the meridian-support-agent repo. Needs:
# Contents (read/write), Actions (read/write), Administration (read/write),
# Dependabot alerts (read), Secret scanning alerts (read).
GITHUB_TOKEN=
GITHUB_TARGET_REPO=your-username/meridian-support-agent

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
